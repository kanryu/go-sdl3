// Go-facing wrappers used by the first renderer example.
cfunc Init(flags int) bool { return SDL_Init(flags) }
cfunc SetAppMetadata(name *byte, version *byte, identifier *byte) bool {
    return SDL_SetAppMetadata(cstring(name), cstring(version), cstring(identifier))
}
cfunc CreateWindow(title *byte, width int, height int, flags int) *byte {
    return SDL_CreateWindow(cstring(title), width, height, flags)
}
cfunc CreateRenderer(window *byte, name *byte) *byte {
    return SDL_CreateRenderer(window, cstring(name))
}
cfunc SetRenderLogicalPresentation(renderer *byte, width int, height int, mode int) bool {
    return SDL_SetRenderLogicalPresentation(renderer, width, height, mode)
}
cfunc SetRenderDrawColor(renderer *byte, red uint8, green uint8, blue uint8, alpha uint8) bool {
    return SDL_SetRenderDrawColor(renderer, red, green, blue, alpha)
}
cfunc RenderClear(renderer *byte) bool { return SDL_RenderClear(renderer) }
cfunc RenderLine(renderer *byte, x1 float32, y1 float32, x2 float32, y2 float32) bool {
    return SDL_RenderLine(renderer, x1, y1, x2, y2)
}
cfunc RenderLines(renderer *byte, points *byte, count int) bool {
    return SDL_RenderLines(renderer, points, count)
}
cfunc RenderPresent(renderer *byte) bool { return SDL_RenderPresent(renderer) }
cfunc PollEvent(event *byte) bool { return SDL_PollEvent(event) }
cfunc Rand(max int32) int32 { return SDL_rand(max) }
cfunc Cos(value float32) float32 { return SDL_cosf(value) }
cfunc Sin(value float32) float32 { return SDL_sinf(value) }
cfunc GetError() cstring { return SDL_GetError() }
cfunc DestroyRenderer(renderer *byte) { SDL_DestroyRenderer(renderer) }
cfunc DestroyWindow(window *byte) { SDL_DestroyWindow(window) }
cfunc Quit() { SDL_Quit() }

cfunc StartTextInput(window *byte) bool { return SDL_StartTextInput(window) }

cfunc StopTextInput(window *byte) bool { return SDL_StopTextInput(window) }

cfunc GetKeyName(key int) cstring { return SDL_GetKeyName(key) }

